/* ================================================================
   WeaponSelector.uss
   ================================================================ */

/* ---- PANEL (базовые общие стили) ---- */

.panel {
    background-color: rgba(8, 8, 8, 0.88);
    border-width: 1px;
    border-color: rgba(255, 185, 50, 0.2);
    border-radius: 6px;
    padding: 18px 21px 21px 21px;
    flex-direction: column;
}

.panel-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(255, 185, 50, 0.12);
}

.panel-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 185, 50, 0.55);
    letter-spacing: 2px;
}

/* ---- WEAPON PANEL ---- */

#weapon-selector {
    /* Ширина задаётся динамически из кода в зависимости от кол-ва оружий */
}

#weapon-selector .slots-container {
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 6px;
}

/* ---- Базовый слот (9 оружий — минимальный размер) ---- */
#weapon-selector .weapon-slot {
    flex-direction: row;
    align-items: stretch;
    /* width/height переопределяются инлайн-стилем из кода */
    width: 178px;
    height: 74px;
    padding: 0px;
    gap: 0px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.03);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

#weapon-selector .weapon-slot:hover {
    background-color: rgba(255, 185, 50, 0.07);
    border-color: rgba(255, 185, 50, 0.2);
}

#weapon-selector .weapon-slot--active {
    background-color: rgba(255, 185, 50, 0.12);
    border-color: rgba(255, 185, 50, 0.5);
}

/* Пустые слоты теперь не отображаются вовсе (скрываются из кода),
   но класс оставляем на случай явного показа */
#weapon-selector .weapon-slot--empty {
    opacity: 0.25;
}

#weapon-selector .weapon-left {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0px 0px 0px 7px;
    flex-shrink: 0;
    width: 50px;
}

/* Левая колонка масштабируется инлайн из кода, но базовое значение: */
#weapon-selector .weapon-left--large {
    width: 70px;
    padding-left: 10px;
}

#weapon-selector .slot-number {
    font-size: 9px;
    color: rgba(255, 185, 50, 0.4);
    -unity-text-align: upper-left;
    width: 100%;
    height: 12px;
    flex-shrink: 0;
    margin-bottom: 2px;
}

#weapon-selector .weapon-slot--active .slot-number {
    color: rgba(255, 185, 50, 0.95);
}

#weapon-selector .weapon-icon {
    width: 44px;
    height: 44px;
    min-width: 36px;
    min-height: 36px;
    flex-shrink: 0;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(255, 185, 50, 0.15);
    border-radius: 3px;
    opacity: 0.75;
}

/* Увеличенная иконка для малого числа оружий */
#weapon-selector .weapon-icon--large {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
}

#weapon-selector .weapon-slot--active .weapon-icon {
    opacity: 1.0;
    border-color: rgba(255, 185, 50, 0.4);
}

#weapon-selector .weapon-icon--empty {
    opacity: 0.0;
}

#weapon-selector .weapon-icon--not-found {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.8);
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.5);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

#weapon-selector .weapon-icon-not-found-label {
    font-size: 6px;
    color: rgba(255, 80, 80, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Правая колонка: название + патроны */
#weapon-selector .weapon-info {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 8px;
    padding-right: 8px;
    overflow: hidden;
}

#weapon-selector .weapon-name {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.6);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    width: 100%;
}

/* Увеличенный шрифт для малого числа оружий */
#weapon-selector .weapon-name--large {
    font-size: 20px;
}

#weapon-selector .weapon-name--empty {
    color: rgba(255, 255, 255, 0.18);
    -unity-font-style: italic;
}

#weapon-selector .weapon-slot--active .weapon-name {
    color: rgba(255, 255, 255, 0.95);
}

#weapon-selector .weapon-ammo {
    font-size: 10px;
    color: rgba(255, 185, 50, 0.5);
    -unity-text-align: middle-left;
    width: 100%;
    margin-top: 3px;
}

/* Увеличенный шрифт патронов для малого числа оружий */
#weapon-selector .weapon-ammo--large {
    font-size: 13px;
    margin-top: 5px;
}

#weapon-selector .weapon-slot--active .weapon-ammo {
    color: rgba(255, 185, 50, 1.0);
}

/* ---- AMMO PANEL — вертикальный ---- */

#ammo-info {
    width: 240px;
}

#ammo-info .ammo-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 16px;
}

#ammo-info .ammo-row:last-child {
    margin-bottom: 0;
}

#ammo-info .ammo-type-label {
    font-size: 9px;
    color: rgba(255, 185, 50, 0.45);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    margin-bottom: 5px;
}

#ammo-info .ammo-bar-bg {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 4px;
}

#ammo-info .ammo-bar {
    height: 6px;
    border-radius: 3px;
    width: 100%;
}

#ammo-info .ammo-count-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    -unity-text-align: middle-right;
}

.ammo-bar--lead      { background-color: rgba(210, 210, 210, 0.8); }
.ammo-bar--buckshot  { background-color: rgba(210, 155, 60,  0.9); }
.ammo-bar--rocket    { background-color: rgba(220, 75,  55,  0.9); }
.ammo-bar--energetic { background-color: rgba(80,  165, 255, 0.9); }

/* ---- ITEMS PANEL — широкий горизонтальный ---- */

#item-selector {
    width: 800px;
}

.not-implemented-badge {
    font-size: 9px;
    color: rgba(255, 185, 50, 0.22);
    -unity-font-style: italic;
}

#item-selector .items-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

#item-selector .item-slot {
    width: 90px;
    height: 90px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

#item-selector .item-slot--empty {
    opacity: 0.28;
}

#item-selector .item-slot-placeholder {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.25);
    -unity-text-align: middle-center;
}
